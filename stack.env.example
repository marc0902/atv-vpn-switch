# Vorlage für die Umgebungsvariablen (Portainer → Stack → Environment variables).
# Echte Werte NICHT ins Repository committen.

# Pflicht: feste IPv4-Adresse des Apple TV
ATV_IP=192.168.178.xxx

# Heimnetz (Fritzbox-Standard)
LAN_CIDR=192.168.178.0/24

# LAN-Schnittstelle des Pi; leer = automatisch über die Default-Route
LAN_IF=

# Ordner auf dem Pi, der als /config eingebunden wird (enthält servers/ und state.json)
CONFIG_PATH=/home/<benutzer>/atv-vpn/config

# Weboberfläche
WEB_PORT=8099
# Optional: Passwort für die Weboberfläche (HTTP Basic Auth, Benutzername beliebig)
WEB_PASSWORD=<dein-passwort>

# Kill-Switch: im Modus Albanien bei Tunnelausfall keinen Verkehr mit deutscher IP
KILLSWITCH=true

# Täglich automatisch auf Deutschland zurücksetzen (HH:MM), leer = aus
AUTO_RESET_TIME=03:00
TZ=Europe/Berlin

# Automatisch zum nächsten Server wechseln, wenn > 3 min kein Handshake
AUTO_FAILOVER=false

# Eigene Routingtabelle
WG_TABLE=51820

# Optionaler Fallback, falls in servers/ noch keine .conf liegt
WG_PRIVATE_KEY=
WG_ADDRESS=
WG_PEER_PUBLIC_KEY=
WG_ENDPOINT=
